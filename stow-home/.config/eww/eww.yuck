(defpoll time         :interval "1s"  "date '+%a  %b %d  %H:%M:%S'")
(defpoll volume       :interval "1s"  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}'")
(defpoll brightness   :interval "10s" "brightnessctl get")
(deflisten active-workspace
  `swaymsg -m -t subscribe '["workspace"]' | jq -r --unbuffered 'select(.change=="focus") | .current.num'`)
(deflisten applications
    `~/dotfiles/scripts/launcher.clj`)

(defwindow cal
    :monitor 0
    :geometry
    (geometry :x "0%"
              :y "5px"
              :width "14%"
              :height "15%"
              :anchor "top center")
    :stacking "fg"
    :exclusive false
    :focusable false
    :namespace "bar"
    (eventbox
     :cursor "pointer"
     (calendar)))

(defwidget time []
  (eventbox
   :onclick "eww open --toggle cal"
   :cursor "help"
   :tooltip "Time"
   (label :text "${time}")))

(defvar workspace-object-array `[
   {"symbol": "", "number": 1},
   {"symbol": "", "number": 2},
   {"symbol": "", "number": 3},
   {"symbol": "󰈹", "number": 4},
   {"symbol": "", "number": 5},
   {"symbol": "", "number": 6}
]`)

(defwidget workspaces []
  (box
   :orientation "horizontal"
   (for workspace in workspace-object-array
        (button
         :class "${workspace.number == active-workspace ? 'active' : ''}"
         :onclick `swaymsg workspace ${workspace.number}`
         `${workspace.symbol}`))))

(defwidget cpu []
  (label :text " ${floor(EWW_CPU.avg)}%"))

(defwidget ram []
  (label :text " ${floor(EWW_RAM.used_mem_perc)}%"))

(defvar volume-icons `["", "", "", "", ""]`)

(defwidget volume []
  (eventbox
   :cursor "pointer"
   :onclick `swaymsg '[title="Volume Control"] move container to workspace current' || pavucontrol &`

   :onscroll `
       wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ $([[ "{}" == up ]] && echo 2%+ || echo 2%-) \
       && eww update volume="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}')"
   `
   (label :text "${volume-icons[floor(volume * 100 / 25)]} ${floor(volume * 100)}%")))

(defvar brightness-icons `["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨", "󰛨"]`)

(defwidget brightness []
  (eventbox
   :onscroll `
       brightnessctl s $([[ "{}" == up ]] && echo +2% || echo 2%-) \
       && eww update brightness="$(brightnessctl g)"
   `
   (label :text `${brightness-icons[floor(brightness * 10 / 255)]} ${floor(brightness * 100 / 255)}%`)))

(defvar battery-charging-icons `["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]`)
(defvar battery-icons          `["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂"]`)

(defwidget battery []
   (label
    :tooltip `${EWW_BATTERY["BAT0"].status}`
    :text
    `${EWW_BATTERY["BAT0"].status == "Charging"
         ? battery-charging-icons[floor(EWW_BATTERY["BAT0"].capacity / 10)]
         : battery-icons[floor(EWW_BATTERY["BAT0"].capacity / 10)]} ${EWW_BATTERY["BAT0"].capacity}%`))

(defwindow bar
    :monitor 0
    :geometry
    (geometry :x "0%"
              :y "0%"
              :width "100%"
              :anchor "top center")
    :stacking "fg"
    :exclusive true
    :focusable false
    :namespace "dock"
    (main))

(defwidget main []
  (centerbox
   :orientation "horizontal"
   
   (box
    :halign "start"
    (workspaces))
   
   (box
    (time))
   
   (box
    :halign "end"
    (systray :halign "end")
    (box
     (cpu)
     (ram)
     (volume)
     (brightness)
     (battery)))))

(defvar current 0)

(defwindow launcher
    :monitor 0
    :geometry
    (geometry :y "5px"
              :height "140px"
              :anchor "top center")
    :stacking "fg"
    :exclusive false
    :focusable true
    :vexpand false
    :namespace "launcher"
    (box
     :orientation "vertical"
     :spacing 0
     :space-evenly false
     :vexpand false
     (input
      :valign "start"
      :onchange `~/dotfiles/scripts/launcher.clj "{}"`
      :onaccept `(${applications[current].command} &) && eww open --toggle launcher`)
     (scroll
      :vexpand true
      (entries))))

(defwidget entries []
  (box
   :orientation "vertical"
   :valign "start"
   :vexpand false
   (for application in applications
        (eventbox
         :cursor "pointer"
         :orientation "horizontal"
         :onclick `(${application.command} &) && eww open --toggle launcher`
         (box
          (label :halign "center" :text "${application.logo}")
          (label :halign "start" :text "${application.name}"))))))
